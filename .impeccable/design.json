  "narrative": {
    "northStar": "Balemoh / Goshtoso",
    "overview": "Balemoh keeps its existing brand assets and Goshtoso theme system. Theme selection and light/dark preferences determine semantic color bindings; the shell supplies inherited typography. This document records the implemented system; it does not establish a replacement identity.\n\nControls use familiar forms, named actions and visible focus. Widgets keep their own content and natural geometry. Structural separators and theme surfaces distinguish editing controls from the content they affect.",
    "keyCharacteristics": [
      "Semantic theme bindings across light and dark modes.",
      "Compact controls with visible keyboard focus.",
      "Natural-height service, host and plugin content."
    ],
    "rules": [
      {
        "name": "The Theme Binding Rule",
        "body": "Reuse the active theme's semantic tokens and their dark counterparts. A default-theme snapshot is not a product-wide palette.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use Goshtoso components and their semantic light/dark token pairs.",
      "Do keep widget links and arbitrary widget content usable while editing.",
      "Do keep focus, selection, disabled and error states distinguishable.",
      "Do verify the homepage editor at 1440px, 1404px and 390px in both color modes."
    ],
    "donts": [
      "Don't replace configured themes, fonts or existing brand assets with fixed palette values.",
      "Don't treat the homepage editor composition as a rule for every product screen.",
      "Don't use preview appearance as proof that a draft has been saved.",
      "Don't remove named movement actions or keyboard access when adding drag interactions."
    ]
  }
