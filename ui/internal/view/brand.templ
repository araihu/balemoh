package view

templ BrandLogo() {
 <span>
  <img class="balemoh-brand-logo balemoh-brand-logo-light" src="/ui/brand/logo-light.svg" alt="Balemoh" width="145" height="32"/>
  <img class="balemoh-brand-logo balemoh-brand-logo-dark" src="/ui/brand/logo-dark.svg" alt="Balemoh" width="145" height="32"/>
 </span>
}

templ BrandHead() {
 <link rel="alternate icon" type="image/png" sizes="32x32" href="/ui/brand/favicon-32.png"/>
 <link rel="apple-touch-icon" sizes="180x180" href="/ui/brand/apple-touch-icon-180.png"/>
 <link rel="manifest" href="/ui/brand/manifest-icons.json"/>
}
