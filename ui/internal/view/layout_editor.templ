package view

import (
 "github.com/araihu/goshtoso/components/alert"
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/checkbox"
 "github.com/araihu/goshtoso/components/form"
 "github.com/araihu/goshtoso/components/table"
 "github.com/araihu/goshtoso/components/layout"
 "github.com/araihu/goshtoso/components/modal"
 "github.com/araihu/goshtoso/components/pageheader"
 selectfield "github.com/araihu/goshtoso/components/select"
 "github.com/araihu/goshtoso/components/textinput"
)

templ LayoutEditorContent(d LayoutEditor) {
 @pageheader.PageHeader(pageheader.Config{Title:"Homepage layout",Description:"Arrange groups and their items. Save applies one layout to the whole instance.",HideSeparator:true})
 <noscript>@alert.Alert(alert.Config{Title:"JavaScript required for editing",Description:"The homepage remains readable. API clients can configure layouts, groups and order."})</noscript>
 <section data-layout-editor={d.Bootstrap}>
  <div id="layout-editor-live" hidden></div>
  <p id="layout-editor-status" role="status" aria-live="polite" tabindex="-1">Loading preview…</p>
  @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-regenerate-provisional","data-layout-action":"regenerate-provisional","hidden":true})) {
   Generate another group ID
  }
  <div id="layout-editor-errors" role="alert" tabindex="-1" hidden></div>
  <div class="balemoh-layout-actions">
   @button.Button(button.WithType("button"),button.Disabled(),button.WithAttrs(templ.Attributes{"id":"layout-action-save","data-layout-action":"save"})) {
    Save layout
   }
   @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-cancel","data-layout-action":"cancel"})) {
    Cancel
   }
   @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-retry","data-layout-action":"retry","hidden":true})) {
    Retry preview
   }
   @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-readback","data-layout-action":"readback","hidden":true})) {
    Check saved result
   }
   @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-view-saved","data-layout-action":"view-saved","hidden":true})) {
    View saved version
   }
   @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-reload","data-layout-action":"reload","hidden":true})) {
    Discard draft and reload
   }
  </div>
  <fieldset data-layout-controls disabled class="balemoh-layout-controls">
  <div id="layout-editor-frame" aria-busy="true">@LayoutEditorFrame(d.Frame)</div>
  </fieldset>
  @modal.Dialog(modal.DialogConfig{ID:"layout-create",Title:"Create group",Content:LayoutCreateDialog()})
  @modal.Dialog(modal.DialogConfig{ID:"layout-delete",Title:"Delete group",Content:LayoutDeleteDialog(d.Frame)})
  @modal.Dialog(modal.DialogConfig{ID:"layout-discard",Title:"Discard unsaved layout?",Content:LayoutDiscardDialog()})
  @modal.Dialog(modal.DialogConfig{ID:"layout-saved",Title:"Saved layout",Content:LayoutSavedDialog()})
 </section>
}

templ LayoutEditorFrame(f LayoutFrame) {
 <div data-layout-targets={f.targetsJSON()}></div>
 <div id="layout-editor-page-controls">@LayoutPageArrangement(f)</div>
 <div class="balemoh-layout-workspace">
  <div id="layout-editor-inspector" class="balemoh-layout-inspector">@LayoutInspector(f)</div>
  <div class="balemoh-layout-preview-column">
   <h2>Preview</h2>
   <fieldset data-layout-preview disabled class={"balemoh-layout-preview",templ.KV("balemoh-homepage-contained",f.Width=="contained")} aria-label="Layout preview">
    <div id="layout-editor-preview-body">@LayoutPreview(f)</div>
   </fieldset>
  </div>
 </div>
}

templ LayoutAction(action,label string) {
 @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"id":"layout-action-"+action,"data-layout-action":action,"data-layout-structural":""})) {
  <span>{label}</span>
 }
}

templ LayoutPreviewGroup(f LayoutFrame,g EditorGroup) {
 <section aria-label={g.Label}>
  <h3 id={"editor-group-heading-"+DOMKey(g.ID)} tabindex="-1" class={templ.KV("sr-only",!g.ShowHeading)}>{g.Label}</h3>
  @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"id":"edit-group-"+DOMKey(g.ID),"data-layout-select-group":g.ID,"aria-pressed":f.SelectedGroup==g.ID})) {
   <span>{"Edit group "+g.Label}</span>
  }
  if g.InitiallyCollapsed {
   <details data-editor-collapse={g.ID}><summary>Show items</summary>
    @layout.Container(f.itemsContainer(g))
   </details>
  } else {
   @layout.Container(f.itemsContainer(g))
  }
  <details><summary>Not currently on home</summary>
   for _,m:=range g.Members {
 if m.State=="dormant" {
    @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithAttrs(templ.Attributes{"id":"edit-item-"+DOMKey(m.ID),"data-layout-select-item":m.ID,"data-layout-item-group":g.ID,"aria-pressed":f.SelectedItem==m.ID})) {
     <span>{"Edit item "+m.Label}</span>
    }
   }
  }
  </details>
 </section>
}

templ LayoutPreviewItem(f LayoutFrame,m EditorMember) {
 <div>
  @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"id":"edit-item-"+DOMKey(m.ID),"data-layout-select-item":m.ID,"aria-pressed":f.SelectedItem==m.ID})) {
   <span>{"Edit item "+m.Label}</span>
  }
  if f.SelectedItem==m.ID {
   <div id="layout-selected-movement" class="balemoh-layout-item-movement">@LayoutItemMovement(f)</div>
  }
  @WidgetContent(m.Widget)
 </div>
}

templ LayoutCreateDialog() {
 <form data-layout-create-form>
  <p data-layout-create-error role="alert" hidden></p>
  @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-regenerate","data-layout-action":"regenerate","hidden":true})) {
   Generate another ID
  }
  @form.FieldGroup(form.FieldGroupConfig{ID:"layout-create-title-field",Label:"Group title",Required:true,Input:&textinput.Config{ID:"layout-create-title",Name:"title",MaxLength:80}})
  @button.Button(button.WithType("submit")) {
   Create group
  }
  @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-close-create","data-layout-action":"close-create"})) {
   Cancel
  }
 </form>
}

templ LayoutDeleteDialog(f LayoutFrame) {
 <p>Move all retained item references and default assignments to a surviving group. Source selections remain unchanged.</p>
 <div id="layout-delete-destinations">@LayoutDeleteDestinations(f)</div>
 @button.Button(button.WithType("button"),button.WithAttrs(templ.Attributes{"id":"layout-action-confirm-delete","data-layout-action":"confirm-delete"})) {
  Delete group and move references
 }
 @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-close-delete","data-layout-action":"close-delete"})) {
  Cancel
 }
}

templ LayoutDiscardDialog() {
 <p>Discard this local draft? Saved layout will remain unchanged.</p>
 @button.Button(button.WithType("button"),button.WithAttrs(templ.Attributes{"id":"layout-action-confirm-discard","data-layout-action":"confirm-discard"})) {
  Discard draft
 }
 @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-close-discard","data-layout-action":"close-discard"})) {
  Keep editing
 }
}

templ LayoutSavedDialog() {
 <div data-layout-saved-summary></div>
 @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-close-saved","data-layout-action":"close-saved"})) {
  Return to draft
 }
}

templ LayoutDeleteDestinations(f LayoutFrame) {
 @form.FieldGroup(form.FieldGroupConfig{ID:"layout-delete-destination-field",Select:&selectfield.Config{ID:"layout-delete-destination",Label:"Move to group",Options:f.groupOptions("")}})
}

templ LayoutLiveWidgets(widgets []Widget) {
 for _,widget:=range widgets {
  <div id={"widget-"+widget.ID} hx-swap-oob="innerMorph">@widget.Content</div>
 }
}

templ LayoutInspector(f LayoutFrame) {
 if f.SelectedItem!="" {
  @LayoutItemInspector(f)
 }

   @form.Section(form.SectionConfig{Title:"Selected group",Columns:"1"}) {
    @form.FieldGroup(form.FieldGroupConfig{ID:"layout-group-choice-field",Select:&selectfield.Config{ID:"layout-group-choice",Label:"Group",Options:f.groupOptions(f.SelectedGroup),InputAttrs:templ.Attributes{"data-layout-action":"select-group","data-layout-structural":""}}})
    {{g:=f.group();key:="layout-group-"+DOMKey(g.ID)}}
    <div data-layout-group-fields-owner={g.ID} class="balemoh-layout-group-fields">
    @form.FieldGroup(form.FieldGroupConfig{ID:key+"-title-field",Label:"Group title",Required:true,Input:&textinput.Config{ID:key+"-title",Value:g.Title,MaxLength:80,InputAttrs:templ.Attributes{"data-layout-field":"/group/title"}}})
    for _,field:=range geometryChoice(key,"/group/layout",g.Arrangement) {
     @form.FieldGroup(field)
    }
    @form.FieldGroup(choice(key+"-order","Item order",g.Order,[]string{"alphabetical","custom"},templ.Attributes{"data-layout-action":"item-order","data-layout-structural":""}))
    @form.FieldGroup(choice(key+"-span","Group width",g.Span,[]string{"auto","full"},templ.Attributes{"data-layout-field":"/group/span","data-layout-span":""}))
    if f.Page.Type=="stack" {
     <p>Group width has no effect while the page uses Stack.</p>
    }
    @form.FieldGroup(form.FieldGroupConfig{ID:key+"-heading-field",Checkbox:&checkbox.Config{ID:key+"-heading",Label:"Show heading",Checked:g.ShowHeading,InputAttrs:templ.Attributes{"data-layout-field":"/group/showHeading"}}})
    @form.FieldGroup(form.FieldGroupConfig{ID:key+"-collapsed-field",Checkbox:&checkbox.Config{ID:key+"-collapsed",Label:"Start collapsed",Checked:g.InitiallyCollapsed,InputAttrs:templ.Attributes{"data-layout-field":"/group/initiallyCollapsed"}}})
    <div class="balemoh-layout-actions">
     @LayoutAction("group-earlier","Move group earlier")
     @LayoutAction("group-later","Move group later")
     @LayoutAction("delete","Delete group")
    </div>
    <details><summary>Identity</summary><code>{g.ID}</code></details>
    </div>
   }
 if f.SelectedItem=="" {
  @LayoutItemInspector(f)
 }
   @form.Section(form.SectionConfig{Title:"Default groups",Columns:"1"}) {
    for _,kind:=range []string{"host","service","other"} {
     @form.FieldGroup(form.FieldGroupConfig{ID:"layout-default-"+kind+"-field",Select:&selectfield.Config{ID:"layout-default-"+kind,Label:kind+" items",Options:f.groupOptions(f.SourceGroups[kind]),InputAttrs:templ.Attributes{"data-layout-field":"/sourceGroups/"+kind,"data-layout-structural":""}}})
    }
   }

}

templ LayoutPreview(f LayoutFrame) {
 @layout.Container(f.previewContainer())
}

templ LayoutPageArrangement(f LayoutFrame) {
   @form.Section(form.SectionConfig{Title:"Page arrangement",Columns:"1"}) {
    <div class="balemoh-layout-page-fields">
    @form.FieldGroup(choice("layout-width","Page width",f.Width,[]string{"full","contained"},templ.Attributes{"data-layout-field":"/homepage/width"}))
    for _,field:=range geometryChoice("layout-page","/homepage/layout",f.Page) {
     @form.FieldGroup(field)
    }
    @form.FieldGroup(choice("layout-page-order","Group order",f.PageOrder,[]string{"alphabetical","custom"},templ.Attributes{"data-layout-action":"page-order","data-layout-structural":""}))
    </div>
    <div class="balemoh-layout-page-footer">
    @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"id":"layout-action-create","data-layout-action":"create","data-layout-structural":""})) {
     Create group
    }
    <p data-layout-capacity>{layoutCapacity(f)}</p>
    </div>
   }

}

templ LayoutItemInspector(f LayoutFrame) {
   @form.Section(form.SectionConfig{Title:"Selected item",Columns:"1"}) {
    @form.FieldGroup(form.FieldGroupConfig{ID:"layout-item-choice-field",Select:&selectfield.Config{ID:"layout-item-choice",Label:"Item",Options:f.itemOptions(),InputAttrs:templ.Attributes{"data-layout-action":"select-item","data-layout-structural":""}}})
    if f.selectedItemDormant() {
     <div id="layout-selected-movement">@LayoutItemMovement(f)</div>
    }

   }

}

templ LayoutComparison(rows []LayoutComparisonRow) {
 <p>Comparison is read-only. Your draft and its original revision remain unchanged.</p>
 <h3>Differences</h3>
 @table.Table(layoutComparisonTable(rows,true))
 <details><summary>All layout settings and identities</summary>
  @table.Table(layoutComparisonTable(rows,false))
 </details>
}

templ LayoutItemMovement(f LayoutFrame) {
    @form.FieldGroup(form.FieldGroupConfig{ID:"layout-destination-field",Select:&selectfield.Config{ID:"layout-destination",Label:"Destination group",Options:f.groupOptions(f.SelectedGroup),InputAttrs:templ.Attributes{"data-layout-destination":"","data-layout-structural":""}}})
    <div class="balemoh-layout-actions">
     @LayoutAction("move-item","Move item to group")
     @LayoutAction("item-earlier","Move item earlier")
     @LayoutAction("item-later","Move item later")
    </div>
    <p>Drag or use the named movement controls. Dormant items keep their saved position.</p>
}
