package view

import (
	"github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/avatar"
 "github.com/araihu/goshtoso/components/icon"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/tooltip"
 "github.com/araihu/goshtoso/components/modal"

	"github.com/araihu/goshtoso/components/form"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/textarea"
	"github.com/araihu/goshtoso/components/textinput"
	"net/url"
)

func EditURL(id string) string { return "/staging/services/" + url.PathEscape(id) + "/edit" }

templ ServiceEditor(service Service) {
	<form
		method="post"
		action={ templ.SafeURL(service.FormURL()) }
		class="balemoh-editor"
 x-on:submit="$el.querySelector('button[type=submit]').disabled=true"
  data-icon-ref={service.IconRef} data-icon-url={service.Icon.URL} data-icon-symbol={service.Icon.Symbol} data-icon-sprite={service.Icon.SpriteURL}
  x-data="{iconRef:$el.dataset.iconRef, iconURL:$el.dataset.iconUrl, iconSymbol:$el.dataset.iconSymbol, iconSprite:$el.dataset.iconSprite}"
  x-on:icon-selected.window="iconRef=$event.detail.id; iconURL=$event.detail.url; iconSymbol=$event.detail.symbol; iconSprite=$event.detail.sprite; $dispatch('modal:close', {id:'service-icon-picker'})"

	>
		if service.Creating {
 <input type="hidden" name="requestId" value={service.CreateKey}/>
 }
 if service.EditError != "" {
			<p role="alert">{ service.EditError }</p>
		}
		@form.FieldGroup(form.FieldGroupConfig{Label: "Name", Required: true, Input: &textinput.Config{ID: "edit-name", Name: "displayName", Value: service.DisplayName, MaxLength: 200}})
		@form.FieldGroup(form.FieldGroupConfig{Label: "Description", Textarea: &textarea.Config{ID: "edit-description", Name: "description", Value: service.Description, Rows: 3, InputAttrs: templ.Attributes{"maxlength": "2000"}}})
		@form.FieldGroup(form.FieldGroupConfig{Label: "Homepage address", Required: service.IsManual(), Hints: service.AddressHints(), Input: &textinput.Config{ID: "edit-address", Name: "address", Type: textinput.TypeURL, Value: service.Address, Placeholder: discoveredAddress(service), MaxLength: 2048}})

  <input type="hidden" name="icon" x-bind:value="iconRef" value={service.IconRef}/>
  <div class="balemoh-editor">
   <div aria-label="Homepage card preview">
 @ServiceCard(serviceEditorPreview(service), ServiceIconPreview(service))
 </div>
  </div>
		<div class="balemoh-editor-actions">
			@button.Button(button.WithType("submit"), button.WithLoadingText("Saving…")) {
 if service.Creating {
 <span>Add service</span>
 } else {
 <span>Save changes</span>
 }
			}
			@link.Link("/staging") {
				Cancel
			}
		</div>
	</form>
   @modal.Dialog(modal.DialogConfig{ID:"service-icon-picker",Title:"Choose service icon",FullscreenMobile:true,Content:ServiceIconPicker(service)})
   @modal.Dialog(modal.DialogConfig{ID:"service-icon-upload",Title:"Upload service icon",FullscreenMobile:true,Content:ServiceIconUpload()})
}

templ ServiceIconPicker(service Service) {
 <div class="balemoh-editor-actions balemoh-icon-picker-actions">
 @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"x-on:click":"$dispatch('modal:close', {id:'service-icon-picker'}); $nextTick(() => { document.getElementById('edit-service-icon').focus(); $dispatch('modal:open', {id:'service-icon-upload'}); })"})) { Upload icon }
 @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithAttrs(templ.Attributes{"x-on:click":"$dispatch('icon-selected', {id:'',url:'',symbol:'',sprite:''})"})) {
 if service.IsManual() {
 <span>Use default icon</span>
 } else {
 <span>Reset to discovery default</span>
 }
 }
 </div>
 <div class="balemoh-editor">
  @IconSearch(IconPage{Picker:true})
  <div id="icon-picker-results"></div>
  @link.Link("/icons",link.WithTarget("_blank")) { Upload or manage icons }
 </div>
}

templ ServiceIconPreview(service Service) {
 @tooltip.Tooltip("edit-service-icon-tooltip", "Change icon", tooltip.WithPosition(tooltip.PositionTop), tooltip.WithTrigger(ServiceIconTrigger(service)))
}

templ ServiceIconTrigger(service Service) {
 @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("balemoh-edit-icon"),button.WithAttrs(templ.Attributes{"id":"edit-service-icon","aria-label":"Change service icon","x-ref":"chooseIcon","x-on:click":"$dispatch('modal:open', {id:'service-icon-picker'})","aria-haspopup":"dialog","aria-controls":"service-icon-picker","hx-get":"/icons/picker","hx-target":"#icon-picker-results","hx-swap":"outerHTML","hx-include":"#picker-search, #picker-search-sources","hx-sync":"#icon-picker-results:replace"})) {
 @avatar.Avatar(avatar.Config{Size: avatar.SizeXS, Shape: avatar.ShapeSquare, Icon: ServicePreviewGlyph(service), RootClass: "balemoh-service-avatar"})
 <span class="balemoh-edit-icon-mark" aria-hidden="true">
 @icon.Icon(icon.Config{SpriteURL:heroicons.SpriteURL,Symbol:heroicons.Icon16SolidPencilSquare,Decorative:true})
 </span>
 }
}
templ ServicePreviewGlyph(service Service) {
 <span class="balemoh-service-card-icon">
  <span x-show="!iconRef">
 @ServiceDefaultIcon(service)
 </span>
  <template x-if="iconRef && iconURL"><img class="balemoh-library-image" x-bind:src="iconURL" alt="Selected icon preview" width="32" height="32"/></template>
  <template x-if="iconRef && iconSymbol"><svg width="32" height="32" aria-hidden="true"><use x-bind:href="iconSprite+'#'+iconSymbol"></use></svg></template>
 </span>
}
templ ServiceDefaultIcon(service Service) {
 @ServiceGlyph(Service{Icon: service.DefaultIcon, Source:service.Source, Resource:service.Resource})
}

templ ServiceIconUpload() {
 <div id="service-icon-upload-body">
  @ServiceIconUploadBody(LibraryIcon{}, "")
 </div>
}
templ ServiceIconUploadBody(i LibraryIcon, message string) {
 if message != "" {
  <p role="alert">{message}</p>
 }
 @IconUploadForm(i, "service-icon-upload-body")
}
func iconUploadCloseEvent(target string) string {
 if target == "service-icon-upload-body" { return "$dispatch('modal:close', {id:'service-icon-upload'})" }
 return "$dispatch('drawer:close', {id:'iconUpload'})"
}
