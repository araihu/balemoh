package view

import (
	"github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/avatar"

	"github.com/araihu/goshtoso/components/form"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/table"
	"github.com/araihu/goshtoso/components/textarea"
	"github.com/araihu/goshtoso/components/textinput"
	"net/url"
)

func EditURL(id string) string { return "/staging/services/" + url.PathEscape(id) + "/edit" }

templ EditAction(service Service) {
	@link.Link(EditURL(service.ID), link.WithAttrs(templ.Attributes{"hx-get": EditURL(service.ID), "hx-target": "#service-editor-body", "hx-swap": "innerHTML", "aria-label": "Edit " + service.DisplayName, "data-service-id": service.ID, "x-on:service-edited.window": "if ($event.detail.id === $el.dataset.serviceId) $el.focus({preventScroll:true})"})) {
		Edit
	}
}

templ ServiceEditor(service Service) {
	<form
		method="post"
		action={ templ.SafeURL(EditURL(service.ID)) }
		class="balemoh-editor"
  data-icon-ref={service.IconRef} data-icon-url={service.Icon.URL} data-icon-symbol={service.Icon.Symbol} data-icon-sprite={service.Icon.SpriteURL}
  x-data="{iconRef:$el.dataset.iconRef, iconURL:$el.dataset.iconUrl, iconSymbol:$el.dataset.iconSymbol, iconSprite:$el.dataset.iconSprite, pickerOpen:false}"
  x-on:icon-selected="iconRef=$event.detail.id; iconURL=$event.detail.url; iconSymbol=$event.detail.symbol; iconSprite=$event.detail.sprite; pickerOpen=false; $refs.chooseIcon.focus()"
		if !service.Standalone {
			hx-post={ EditURL(service.ID) }
			hx-target="#service-editor-body"
			hx-swap="innerHTML"
			hx-disabled-elt="find button[type='submit']"
			hx-params="displayName,description,address,icon"
		}
	>
		if service.EditError != "" {
			<p role="alert">{ service.EditError }</p>
		}
		@form.FieldGroup(form.FieldGroupConfig{Label: "Name", Required: true, Input: &textinput.Config{ID: "edit-name", Name: "displayName", Value: service.DisplayName, MaxLength: 200}})
		@form.FieldGroup(form.FieldGroupConfig{Label: "Description", Textarea: &textarea.Config{ID: "edit-description", Name: "description", Value: service.Description, Rows: 3, InputAttrs: templ.Attributes{"maxlength": "2000"}}})
		@form.FieldGroup(form.FieldGroupConfig{Label: "Homepage address", Hints: []string{"Leave blank to use discovered addresses."}, Input: &textinput.Config{ID: "edit-address", Name: "address", Type: textinput.TypeURL, Value: service.Address, Placeholder: discoveredAddress(service), MaxLength: 2048}})

  <input type="hidden" name="icon" x-bind:value="iconRef" value={service.IconRef}/>
  <div class="balemoh-editor">
   <div aria-label="Homepage card preview">
 @ServiceCard(service, ServiceIconPreview(service))
 </div>
   @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"x-ref":"chooseIcon","x-on:click":"pickerOpen=!pickerOpen","x-bind:aria-expanded":"pickerOpen","aria-controls":"service-icon-picker","hx-get":"/icons/picker","hx-target":"#icon-picker-results","hx-swap":"outerHTML","hx-include":"#picker-search, #picker-search-sources","hx-params":"q,source","hx-sync":"#icon-picker-results:replace"})) {
 Choose icon
 }
   <div id="service-icon-picker" x-show="pickerOpen" style="display:none" x-on:keydown.escape.stop="pickerOpen=false; $refs.chooseIcon.focus()">
    @IconSearch(IconPage{Picker:true})
    <div id="icon-picker-results"></div>
    @link.Link("/icons",link.WithTarget("_blank")) {
 Upload or manage icons
 }
   </div>
   @button.Button(button.WithType("button"),button.WithTone(button.ToneAlternate),button.WithAttrs(templ.Attributes{"x-on:click":"iconRef=''; iconURL=''; iconSymbol=''; iconSprite=''; pickerOpen=false"})) {
 Reset to discovery default
 }
  </div>
		<div class="balemoh-editor-actions">
			@button.Button(button.WithType("submit"), button.WithLoadingText("Saving…")) {
				Save changes
			}
			@link.Link("/staging", link.WithAttrs(templ.Attributes{"x-on:click": "if (document.getElementById('service-editor-body')) { $event.preventDefault(); $dispatch('drawer:close', {id:'serviceEditor'}) }"})) {
				Cancel
			}
		</div>
	</form>
}

templ ServiceIconPreview(service Service) {
 @avatar.Avatar(avatar.Config{Size: avatar.SizeXS, Shape: avatar.ShapeSquare, Icon: ServicePreviewGlyph(service), RootClass: "balemoh-service-avatar"})
}
templ ServicePreviewGlyph(service Service) {
 <span class="balemoh-service-card-icon">
  <span x-show="!iconRef">
 @ServiceDefaultIcon(service)
 </span>
  <template x-if="iconRef && iconURL"><img class="balemoh-library-image" x-bind:src="iconURL" alt="Selected icon preview" width="32" height="32"/></template>
  <template x-if="iconRef && iconSymbol"><svg width="32" height="32" aria-hidden="true"><use x-bind:href="iconSprite+'#'+iconSymbol"></use></svg></template>
 </span>
}
templ ServiceDefaultIcon(service Service) {
 @ServiceGlyph(Service{Icon: service.DefaultIcon, Source:service.Source, Resource:service.Resource})
}

templ EditedRow(service Service) {
	<template>
		@table.TableRow(table.Config{ID: "balemoh-services", Columns: serviceTableColumns(true)}, editedTableRow(service))
	</template>
}
