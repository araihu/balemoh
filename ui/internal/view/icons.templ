package view

import (
 "fmt"
 "strings"
 "strconv"
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/card"
 "github.com/araihu/goshtoso/components/combobox"
 "github.com/araihu/goshtoso/components/fileinput"
 "github.com/araihu/goshtoso/components/icon"
 "github.com/araihu/goshtoso/components/link"
 "github.com/araihu/goshtoso/components/pageheader"
 "github.com/araihu/goshtoso/components/textinput"
)

templ LibraryImage(i LibraryIcon) {
 if i.Symbol != "" {
  @icon.Icon(icon.Config{SpriteURL:i.SpriteURL, Symbol:icon.Symbol(i.Symbol), Decorative:true})
 } else if i.URL != "" {
  <img class="balemoh-library-image" src={i.URL} alt="" width="40" height="40" loading="lazy"/>
 }
}

templ IconsContent(data IconPage) {
 @pageheader.PageHeader(pageheader.Config{Title:"Icons",HideSeparator:true,Actions:IconPageActions(data)})
 if data.Editing != nil && data.Error != "" {
  <p role="alert">{data.Error}</p>
 }
 if data.Editing != nil {
  @IconUploadForm(*data.Editing, false)
 } else {
  @IconSearch(data)
  @IconResults(data)
 }
}

templ IconSearch(data IconPage) {
 <div class="balemoh-icon-search" hx-get={iconSearchPath(data.Picker)} hx-trigger="input delay:300ms, combobox:change" hx-target="#icon-picker-results" hx-swap="outerHTML" hx-sync="#icon-picker-results:replace" hx-include="this" hx-params="q,source" hx-replace-url={strconv.FormatBool(!data.Picker)}>
  @textinput.TextInput(textinput.Config{ID:iconSearchID(data.Picker),Name:"q",Label:"Search icons",Type:textinput.TypeSearch,Value:data.Query,Placeholder:"Name or tag"})
  {{ config := combobox.Config{ID:iconSearchID(data.Picker)+"-sources",Name:"source",Label:"Icon sources",Placeholder:"All sources",Mode:combobox.ModeMultiple,EnableClearAll:true,DisablePersistence:true,Selected:data.Sources,Source:combobox.Source{Static:[]combobox.Option{{Value:"goshtoso",Label:"Goshtoso"},{Value:"selfhst",Label:"selfh.st"},{Value:"uploads",Label:"Uploads"}}}} }}
  @combobox.Combobox(config,config.InitialState())
 </div>
}

func iconSearchID(picker bool)string{if picker{return "picker-search"};return "icon-search"}
func iconSearchPath(picker bool)string{if picker{return "/icons/picker"};return "/icons"}

templ IconPageActions(data IconPage) {
 if data.Editing == nil {
  @button.Button(button.WithType("button"),button.WithAttrs(templ.Attributes{"x-data":"{}","x-on:click":"$dispatch('drawer:open', {id:'iconUpload'})","aria-haspopup":"dialog","aria-controls":"icon-upload-body"})) {
   Upload icon
  }
 }
}

templ IconUploadDrawerBody(i LibraryIcon, message string) {
 <div class="balemoh-icon-upload-body">
  if message != "" {
   <p role="alert">{message}</p>
  }
  @IconUploadForm(i, true)
 </div>
}

templ IconUploadForm(i LibraryIcon, inDrawer bool) {
 <form class="balemoh-editor balemoh-upload-form" method="post" action={templ.SafeURL(iconSaveURL(i.ID))} enctype="multipart/form-data"
  if inDrawer {
   hx-post="/icons/upload" hx-encoding="multipart/form-data" hx-target="#icon-upload-body" hx-swap="innerHTML" hx-disabled-elt="find button[type='submit']" hx-sync="this:drop"
  }
 >
  if i.ID != "" {
   @LibraryImage(i)
   <p>{iconUsageLabel(len(i.UsedBy))}</p>
   if len(i.UsedBy)>0 {
    <p>{strings.Join(i.UsedBy,", ")}. Replacing this image updates these services.</p>
   }
  }
  <input type="hidden" name="digest" value={i.Digest}/>
  @textinput.TextInput(textinput.Config{ID:"icon-name",Name:"name",Label:"Name",Value:i.Name,Required:true,MaxLength:200})
  @textinput.TextInput(textinput.Config{ID:"icon-tags",Name:"tags",Label:"Tags",Value:i.Tags,MaxLength:1000,Placeholder:"Comma-separated tags"})
  @fileinput.FileInput(fileinput.Config{ID:"icon-upload",Name:"image",Label:"Image",Appearance:fileinput.AppearanceUpload,Required:i.ID=="",Accept:"image/png,image/jpeg,image/webp,image/svg+xml",HelperText:"PNG, JPEG, WebP, or passive SVG. Up to 2 MiB and 4096 pixels. Leave empty to keep the current image."})
  @button.Button(button.WithType("submit"),button.WithLoadingText("Saving…")) {
   Save icon
  }
  if inDrawer {
   @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithAttrs(templ.Attributes{"x-on:click":"$dispatch('drawer:close', {id:'iconUpload'})"})) {
    Cancel
   }
  } else {
   @link.Link("/icons") {
    Back to Icons
   }
  }
 </form>
 if i.ID!="" && len(i.UsedBy)==0 {
  <details class="balemoh-icon-upload">
   <summary>Delete icon</summary>
   <p>This removes the unused uploaded icon.</p>
   <form method="post" action={templ.SafeURL("/icons/"+i.ID+"/delete")}>
    <input type="hidden" name="digest" value={i.Digest}/>
    @button.Button(button.WithType("submit"),button.WithTone(button.ToneDanger)) {
     Delete icon
    }
   </form>
  </details>
 }
}

func iconSaveURL(id string)string{if id==""{return "/icons/upload"};return "/icons/"+id+"/edit"}

templ IconResults(data IconPage) {
 <div id="icon-picker-results" class="balemoh-icon-results">
  if data.Error!="" {
   <p role="alert">{data.Error}</p>
  }
  <p role="status">{fmt.Sprintf("%d icons",data.Total)}</p>
  <div class="balemoh-icon-grid">
   @IconBatch(data)
  </div>
 </div>
}

templ IconBatch(data IconPage) {
 for _,i:=range data.Icons {
  @card.Card(card.Config{RootClass:"balemoh-icon-tile",Body:IconTileBody(i,data.Picker)})
 }
 if data.Page*48<data.Total {
  <div id="icon-scroll-next" class="balemoh-icon-more" x-data="{failed:false}" x-on:htmx:response-error="failed=true" x-on:htmx:send-error="failed=true">
   @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithLoadingText("Loading icons…"),button.WithAttrs(templ.Attributes{"hx-get":IconPageURL(data,data.Page+1),"hx-trigger":"intersect once, click","hx-target":"#icon-scroll-next","hx-swap":"outerHTML","hx-sync":"#icon-picker-results:drop","hx-params":"none","hx-push-url":"false","hx-replace-url":"false","hx-disabled-elt":"this"})) {
    Load more icons
   }
   <p role="alert" x-show="failed" x-cloak>Could not load more icons. Try again.</p>
  </div>
 }
}

templ AttributionLinks() {
 <nav class="balemoh-footer-links" aria-label="Attributions and licenses">
  @link.Link("https://selfh.st/icons/",link.WithTarget("_blank")) {
   Icons by selfh.st
  }
  @link.Link("/ui/icon-library/selfhst/LICENSES/selfhst.txt",link.WithTarget("_blank")) {
   Icon license
  }
 </nav>
}

templ IconTileBody(i LibraryIcon, picker bool) {
 <div class="balemoh-icon-tile-content" data-icon-id={i.ID}>
     if picker {
      @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("balemoh-icon-choice"),button.WithAttrs(templ.Attributes{"aria-label":"Choose "+i.Name,"data-icon-id":i.ID,"data-icon-url":i.URL,"data-icon-symbol":i.Symbol,"data-icon-sprite":i.SpriteURL,"x-on:click":"$dispatch('icon-selected', {id:$el.dataset.iconId, url:$el.dataset.iconUrl, symbol:$el.dataset.iconSymbol, sprite:$el.dataset.iconSprite})"})) {
       @LibraryImage(i)
       <span>{i.Name}</span>
      }
     } else {
      @LibraryImage(i)
      <strong>{i.Name}</strong>
      <small>{i.Source}</small>
      if i.Source=="uploads" {
       @link.Link(IconEditURL(i.ID)) {
        Manage
       }
      } else {
       <details>
        <summary>Details</summary>
        <p>{i.Tags}</p>
        <p>{i.License}</p>
        if i.LightURL!="" {
         <img src={i.LightURL} width="40" height="40" alt={i.Name+" light variant"} loading="lazy"/>
        }
        if i.DarkURL!="" {
         <img src={i.DarkURL} width="40" height="40" alt={i.Name+" dark variant"} loading="lazy"/>
        }
       </details>
      }
     }

 </div>
}
