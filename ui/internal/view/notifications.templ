package view

import (
	"fmt"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/pageheader"
	"github.com/araihu/goshtoso/components/panel"
	"github.com/araihu/goshtoso/components/popover"
	"net/url"
	"time"
)

templ NotificationBell() {
	@popover.Popover(popover.Config{ID: "balemoh-notifications", Trigger: NotificationTrigger(), Content: NotificationTray(), Placement: popover.PlacementBottomEnd, Role: "dialog", Label: "Notifications", TrapFocus: true, RootClass: "balemoh-notification-popover", PanelClass: "balemoh-notification-panel"})
	<noscript>@link.Link("/notifications") {
	Notifications
}</noscript>
}

templ NotificationTrigger() {
	@button.Button(button.WithID("notification-trigger"), button.WithAppearance(button.AppearancePlain), button.WithRootClass("balemoh-header-icon balemoh-notification-trigger"), button.WithAttrs(templ.Attributes{"aria-label": "Notifications, loading", "title": "Notifications", "data-notification-trigger": true, "x-cloak": true})) {
		@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidBell, Decorative: true})
		<span id="notification-summary" aria-hidden="true" data-notification-summary hx-sync="#balemoh-notifications:queue all" hx-request="timeout:4s"><span class="balemoh-notification-count" data-notification-loading>…</span></span>
	}
}

templ NotificationSummary(count int, available bool) {
	<span data-notification-available={ fmt.Sprint(available) } data-notification-count={ fmt.Sprint(count) }>
		if !available {
			<span class="balemoh-notification-count balemoh-notification-count-warning">!</span>
		} else if count > 0 {
			<span class="balemoh-notification-count">{ notificationCount(count) }</span>
		}
	</span>
}

templ NotificationSummaryOOB(count int, available bool) {
	<span id="notification-summary" hx-swap-oob="innerMorph">@NotificationSummary(count, available)</span>
}

templ NotificationPageCount(count int, available, oob bool) {
	<span
		id="notification-page-count"
		if oob {
			hx-swap-oob="innerMorph"
		}
	>
		if available {
			{ fmt.Sprintf("%d unread",count) }
		} else {
			Unavailable
		}
	</span>
}

templ NotificationTray() {
	<div class="balemoh-notification-heading"><h2>Notifications</h2>@NotificationRefresh()</div>
	<div id="notification-tray" data-notification-tray hx-sync="#balemoh-notifications:queue all" hx-request="timeout:4s" aria-live="polite"><p class="balemoh-muted">Loading notifications…</p></div>
	<div class="balemoh-notification-footer">@link.Link("/notifications") {
	All notifications
}</div>
}

templ NotificationRefresh() {
	@button.Button(button.WithID("notification-refresh"), button.WithAppearance(button.AppearancePlain), button.WithRootClass("balemoh-header-icon"), button.WithAttrs(templ.Attributes{"data-notification-refresh": true, "aria-label": "Refresh notifications", "title": "Refresh notifications"})) {
		@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidArrowPath, Decorative: true})
	}
}

templ NotificationList(page NotificationsPage, tray bool) {
	if page.Error != "" {
		<p role="status" class="balemoh-notification-message">{ page.Error }</p>
	} else if len(page.Items) == 0 {
		<p class="balemoh-muted balemoh-notification-message">No notifications.</p>
	} else {
		<ul class="balemoh-notification-list">
			for _, item := range page.Items {
				<li id={ "notification-item-" + item.ID } class="balemoh-notification-item">
					<div class="balemoh-notification-meta">
						@badge.Badge(badge.Config{Label: item.Severity, Tone: notificationTone(item.Severity), Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
						<time datetime={ item.ReceivedAt.UTC().Format(time.RFC3339Nano) } title={ item.ReceivedAt.UTC().Format(time.RFC1123) }>{ notificationAge(item.ReceivedAt) }</time>
					</div>
					<h3>{ item.Title }</h3>
					if item.Body != "" {
						<p class="balemoh-notification-body">{ item.Body }</p>
					}
					<p class="balemoh-muted balemoh-notification-source">{ item.Source }</p>
					<div class="balemoh-notification-actions">
						if item.HasDestination {
							if item.External {
								@link.Link("/notifications/"+item.ID+"/open", link.WithTarget("_blank"), link.WithRel("noopener noreferrer"), link.WithIcon(icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidArrowTopRightOnSquare, Decorative: true}))) {
									Open source <span class="sr-only">in a new tab</span>
								}
							} else {
								@link.Link("/notifications/" + item.ID + "/open") {
									Open details
								}
							}
						}
						<div id={ "notification-read-" + item.ID } tabindex="-1">@NotificationReadControl(item.ID, item.Read, "", notificationReturnPath(page, tray))</div>
					</div>
				</li>
			}
		</ul>
	}
}

func notificationReturnPath(page NotificationsPage, tray bool) string {
	if tray {
		return "tray"
	}
	query := url.Values{}
	if page.Before != "" {
		query.Set("before", page.Before)
	}
	if page.UnreadOnly {
		query.Set("unread", "true")
	}
	if len(query) > 0 {
		return "/notifications?" + query.Encode()
	}
	return "/notifications"
}

templ NotificationReadControl(id string, read bool, failure, returnTo string) {
	if read {
		<span class="balemoh-muted" role="status">Read</span>
	} else {
		<form method="post" action={ templ.SafeURL("/notifications/" + id + "/read") } hx-post={ "/notifications/" + id + "/read" } hx-target={ "#notification-read-" + id } hx-swap="innerMorph" hx-sync="#balemoh-notifications:queue all" hx-request="timeout:4s" hx-disable="find button[type='submit']">
			<input type="hidden" name="returnTo" value={ returnTo }/>
			@button.Button(button.WithAppearance(button.AppearancePlain), button.WithType("submit"), button.WithLoadingText("Saving…")) {
				Mark read
			}
		</form>
		if failure!="" {
			<p role="alert">{ failure }</p>
		}
	}
}

templ NotificationsContent(page NotificationsPage) {
	@pageheader.PageHeader(pageheader.Config{Title: "Notifications", Description: "Messages from Balemoh, plugins and connected integrations.", HideSeparator: true})
	<div class="balemoh-notification-page-toolbar">
		@NotificationPageCount(page.UnreadCount, page.Error == "", false)
		if page.UnreadOnly {
			@link.Link("/notifications") {
				Show all
			}
		} else {
			@link.Link("/notifications?unread=true") {
				Unread only
			}
		}
	</div>
	@panel.Panel(panel.Config{}) {
		<div id="notification-page-list" tabindex="-1">@NotificationList(page, false)</div>
	}
	if page.NextCursor!="" {
		@link.Link("/notifications?before=" + url.QueryEscape(page.NextCursor) + notificationUnreadQuery(page.UnreadOnly)) {
			Older notifications
		}
	}
}

func notificationUnreadQuery(unread bool) string {
	if unread {
		return "&unread=true"
	}
	return ""
}
