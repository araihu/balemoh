package view

import (
 "fmt"
 "strconv"
 "time"
 "github.com/araihu/balemoh/ui/internal/appicons"
 "github.com/araihu/goshtoso/components/avatar"
 "github.com/araihu/goshtoso/components/alert"
 "github.com/araihu/goshtoso/components/badge"
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/card"
 "github.com/araihu/goshtoso/components/emptystate"
 "github.com/araihu/goshtoso/components/link"
 "github.com/araihu/goshtoso/components/pageheader"
 "github.com/araihu/goshtoso/components/table"
 "github.com/araihu/goshtoso/components/tabs"
 "github.com/araihu/goshtoso/components/tooltip"
 "github.com/araihu/goshtoso-charts/components/interactive/line"
 "github.com/araihu/goshtoso-charts/components/chart"
 "github.com/araihu/goshtoso-charts/components/chartcontrol"
)

type Host struct {
 ID,Name,Kind,Status,ParentID,Ready,Architecture string
 ObservedAt,ReceivedAt *time.Time
 CPU,Memory *float64
 MemoryUsed,MemoryTotal *int64
 InventoryAvailable bool
}
type HostsPage struct { Hosts []Host; Selected map[string]bool; SelectionError string }
type HostSample struct {At time.Time; CPU,Memory *float64}
type HostWorkload struct{Name,Namespace,State string;Restarts int}
type HostService struct{ID,Name string}
type HostDetail struct {
 Host Host
 Window string
 Children []Host
 Samples []HostSample
 Workloads []HostWorkload
 Services []HostService
 ServicesAvailable bool
 Pinned bool
 Missing bool
 SelectionError string
}
func hostRows(hosts []Host, selection *HostsPage) []table.Row {
 rows := make([]table.Row, 0, len(hosts))
 for _, host := range hosts {
  row := table.Row{ID: host.ID, Cells: map[string]table.Cell{
   "host": {Component: HostLink(host)}, "status": {Text: hostStatus(host.Status)},
   "architecture": {Text: hostArchitecture(host)},
   "cpu": {Text: percentage(host.CPU)}, "memory": {Text: percentage(host.Memory)},
  }}
  if selection != nil {
   row.Cells["select"] = table.Cell{Component: HostSelection(host.ID, selection.Selected[host.ID], selection.SelectionError != "", "1h", "", false, true)}
  }
  rows = append(rows, row)
 }
 return rows
}
func hostArchitecture(host Host)string{if host.Kind=="Kubernetes cluster"{return "See nodes"};if host.Architecture==""{return "Unknown"};return host.Architecture}
func hostStatus(status string)string{switch status{case "fresh":return "Reporting";case "partial":return "Partial data";case "stale":return "Stale";default:return "No telemetry"}}
func hostStatusTone(status string)badge.Tone{switch status{case "fresh":return badge.ToneSuccess;case "partial","stale":return badge.ToneWarning;default:return badge.ToneInfo}}
func percentage(value *float64)string{if value==nil{return "Unavailable"};return fmt.Sprintf("%.1f%%",*value)}
func memorySize(value *int64)string{if value==nil{return "Unavailable"};return fmt.Sprintf("%.1f GiB",float64(*value)/(1<<30))}
func historyChart(page HostDetail,cpu bool)line.Config{
 title:="Memory usage";if cpu{title="CPU usage"}
 cfg:=line.Config{Label:title,Width:"100%",Height:"280px"}
 cfg.Options=chart.ChartOptions{
  Controls:chartcontrol.Options{Mode:chartcontrol.WrapperModeOmitted},
  Export:&chartcontrol.ExportOptions{Disabled:true},
  Tooltip:&chart.TooltipOptions{Show:chart.Bool(true),Trigger:"axis"},
  Legend:&chart.LegendOptions{Show:chart.Bool(false)},
  XAxis:&chart.AxisOptions{LabelInterval:chart.Int(max(0,len(page.Samples)/2-1)),ShowFirstLabel:chart.Bool(true),ShowLastLabel:chart.Bool(true)},
  YAxis:&chart.AxisOptions{Name:"%",Min:chart.Float(0),Max:chart.Float(100),SplitNumber:4},
  Animation:chart.Bool(false),
 }
 cfg.SeriesOptions=chart.SeriesOptions{ShowSymbol:chart.Bool(false)}
 points:=make([]line.Data,0,len(page.Samples))
 for _,sample:=range page.Samples{cfg.XAxis=append(cfg.XAxis,sample.At.UTC().Format("15:04"));value:=sample.Memory;if cpu{value=sample.CPU};point:=line.Data{Missing:value==nil};if value!=nil{point.Value=*value};points=append(points,point)}
 cfg.Series=[]line.Series{{Name:title+" (%)",Data:points}};return cfg
}
func hasHistory(page HostDetail,cpu bool)bool{for _,s:=range page.Samples{if cpu&&s.CPU!=nil||!cpu&&s.Memory!=nil{return true}};return false}
func workloadRows(workloads []HostWorkload)[]table.Row{
 rows:=[]table.Row{};for i,w:=range workloads{rows=append(rows,table.Row{ID:fmt.Sprintf("workload-%d",i),Cells:map[string]table.Cell{"name":{Text:w.Name},"namespace":{Text:w.Namespace},"state":{Text:w.State},"restarts":{Text:strconv.Itoa(w.Restarts)}}})};return rows
}
templ HostLink(host Host) {
 @link.Link("/hosts/"+host.ID) { @HostIdentity(host) }
 <small class="balemoh-muted">{ host.Kind }</small>
}
templ HostIdentity(host Host) {
 <span class="balemoh-service-name">
 @avatar.Avatar(avatar.Config{Size:avatar.SizeXS,Shape:avatar.ShapeSquare,Icon:HostGlyph(host),RootClass:"balemoh-service-avatar"})
 <span>{ host.Name }</span>
 </span>
}
templ HostGlyph(host Host) {
 <span class="balemoh-service-card-icon">
 switch host.Kind {
 case "Kubernetes cluster":
 @appicons.Icon(appicons.Config{Symbol:appicons.IconKubernetesKubernetes,Decorative:true})
 case "Docker host":
 @appicons.Icon(appicons.Config{Symbol:appicons.IconDockerDocker,Decorative:true})
 default:
 @appicons.Icon(appicons.Config{Symbol:appicons.IconHeroiconsServer,Decorative:true})
 }
 </span>
}
func hostColumns(selection *HostsPage) []table.Column {
 columns:=[]table.Column{}
 if selection!=nil {columns=append(columns,table.Column{Key:"select",Label:"Pinned",HeaderSuffix:tooltip.Help("host-pinning-help","How pinning works","Check to show a host on your homepage. Uncheck to remove it. Changes save immediately."),Width:"balemoh-col-select"})}
 return append(columns,[]table.Column{{Key:"host",Label:"Host"},{Key:"architecture",Label:"Architecture"},{Key:"status",Label:"Telemetry"},{Key:"cpu",Label:"CPU"},{Key:"memory",Label:"Memory"}}...)
}
templ HostTable(hosts []Host, selection *HostsPage) {
 <div class="balemoh-table-scroll">
 @table.Table(table.Config{ID:"hosts-table",RootClass:"balemoh-host-list",Caption:"Hosts and latest reported usage",Columns:hostColumns(selection),Rows:hostRows(hosts,selection)})
 </div>
}
templ HostsContent(page HostsPage, available bool) {
 @pageheader.PageHeader(pageheader.Config{Title:"Hosts",HideSeparator:true})
 if available {
  if len(page.Hosts)==0 {
   @emptystate.EmptyState(emptystate.Config{Title:"No hosts discovered",Description:"Registered sources appear here before their first telemetry report."})
  } else {
   if page.SelectionError!="" {
    @alert.Alert(alert.Config{Title:"Homepage selection unavailable",Description:page.SelectionError,Tone:alert.ToneWarning})
   }
   @HostTable(page.Hosts,&page)
  }
 }
}
templ ReportTime(label string,at *time.Time) {
 <span>
  { label }
  if at==nil {
   never
  } else {
   <time datetime={ at.UTC().Format(time.RFC3339) }>{ at.UTC().Format("Jan 02, 15:04:05 UTC") }</time>
  }
 </span>
}
templ HostContent(page HostDetail) {
 <nav aria-label="Breadcrumb" class="balemoh-host-actions">
  @link.Link("/hosts") { Hosts }
  if page.Host.ParentID!="" {
   <span>/</span>
   @link.Link("/hosts/"+page.Host.ParentID) { Cluster }
  }
 </nav>
 @pageheader.PageHeader(pageheader.Config{Title:page.Host.Name,TitleSuffix:HostDetailIndicators(page.Host),HideSeparator:true,Actions:HostSelection(page.Host.ID,page.Pinned,page.SelectionError!="",page.Window,page.SelectionError,false,false)})
 if page.Missing {
 @alert.Alert(alert.Config{Title:"Host no longer available",Description:"Uncheck Show on home to remove this widget.",Tone:alert.ToneWarning})
 } else {
 @tabs.Tabs(tabs.Config{ID:"host-tabs",RootClass:"min-w-0",DefaultTab:"overview",SyncHash:true,Tabs:hostTabs(page)})
 }
}
func hostTabs(page HostDetail)[]tabs.Tab{
 result:=[]tabs.Tab{{ID:"overview",Label:"Overview",Content:HostOverviewPanel(page)}}
 if page.Host.Kind=="Kubernetes cluster"{result=append(result,tabs.Tab{ID:"nodes",Label:"Nodes",Content:HostNodesPanel(page)})}
 result=append(result,tabs.Tab{ID:"workloads",Label:"Workloads",Content:HostWorkloadsPanel(page)})
 if page.Host.ParentID==""{result=append(result,tabs.Tab{ID:"services",Label:"Services",Content:HostServices(page)})}
 return result
}
templ HostOverviewPanel(page HostDetail){
 <div id="host-overview">@HostOverview(page)</div>
}
templ HostOverview(page HostDetail){
 <div id={ "host-live-"+page.Window } class="sr-only" data-host-live hx-sse:connect={ "/hosts/"+page.Host.ID+"/events?range="+page.Window } hx-target="#host-live-status" hx-swap="innerMorph">
  <div id="host-live-status" role="status" hx-morph-skip>@HostLiveBadge("Connecting to live updates…")</div>
 </div>
 <div id="host-measurements">@HostMeasurements(page)</div>
 <div class="balemoh-host-actions">
  <h2>Usage history</h2>
  <nav aria-label="History range" class="balemoh-host-actions">
   @HistoryRange(page,"1h","Last hour")
   @HistoryRange(page,"24h","Last 24 hours")
   {{ refreshAttrs := historyLinkAttrs(page,page.Window) }}
   {{ refreshAttrs["id"] = "host-history-refresh" }}
   @link.Link("/hosts/"+page.Host.ID+"?range="+page.Window,link.WithAttrs(refreshAttrs)) { Refresh }
  </nav>
  <span id="host-history-error" role="alert"></span>
 </div>
 <div class="balemoh-host-grid">
  @card.Card(card.Config{RootClass:"balemoh-host-card",Title:"CPU usage",Body:HostChart(page,true)})
  @card.Card(card.Config{RootClass:"balemoh-host-card",Title:"Memory usage",Body:HostChart(page,false)})
 </div>
}
templ HostServices(page HostDetail){
 if page.Host.ParentID=="" {
  <p class="balemoh-muted">Applications discovered on this source, with their catalog settings and homepage links. One application can include several workloads.</p>
  if !page.ServicesAvailable {
   <p>Catalog services are unavailable.</p>
  } else if len(page.Services)==0 {
   <p>No catalog services discovered for this source.</p>
  } else {
   <ul class="balemoh-host-services">
    for _,service:=range page.Services {
     <li>@link.Link("/staging/services/"+service.ID+"/edit") { { service.Name } }</li>
    }
   </ul>
  }
 }
}
templ HostNodesPanel(page HostDetail){
 <div id="host-nodes">@HostNodes(page)</div>
}
templ HostWorkloadsPanel(page HostDetail){
 <div id="host-workloads-panel">@HostWorkloads(page)</div>
}

func workloadColumns(kind string)[]table.Column{
 columns:=[]table.Column{{Key:"name",Label:"Name"},{Key:"state",Label:"State"}}
 if kind!="Docker host"{columns=append(columns,table.Column{Key:"namespace",Label:"Namespace"},table.Column{Key:"restarts",Label:"Restarts"})};return columns
}
func historyLinkAttrs(page HostDetail,window string)templ.Attributes{
 return templ.Attributes{"hx-get":"/hosts/"+page.Host.ID+"?range="+window,"hx-target":"#host-overview","hx-swap":"innerHTML","hx-push-url":strconv.FormatBool(window!=page.Window),"hx-sync":"#host-overview:replace"}
}
templ HostHistoryError(message string) {
 <span id="host-history-error" hx-swap-oob="innerMorph">{ message }</span>
}
templ HistoryRange(page HostDetail,value,label string) {
 {{ attrs := historyLinkAttrs(page,value) }}
 {{ attrs["aria-current"] = activeRange(page.Window,value) }}
 {{ attrs["id"] = "host-history-"+value }}
 @link.Link("/hosts/"+page.Host.ID+"?range="+value, link.WithAttrs(attrs)) { { label } }
}
func activeRange(current,value string)string{if current==value{return "true"};return "false"}
templ MetricValue(value,description string) {
 <p class="balemoh-metric-value">{ value }</p>
 <p class="balemoh-muted">{ description }</p>
}
// Keep dismissal for the current status across SSE morphs. A status change gets a new notice.
templ HostNotice(status,title,description string,tone alert.Tone) {
 <div id={ "host-notice-"+status } class="balemoh-host-notice" hx-morph-skip hx-preserve>
  @alert.Alert(alert.Config{Title:title,Description:description,Tone:tone,Dismissible:true})
 </div>
}
templ HostMeasurements(page HostDetail) {
 <div class="balemoh-host-status">
  if page.Host.Kind!="Kubernetes cluster" {
   <span>Architecture: { hostArchitecture(page.Host) }</span>
  }
  @ReportTime("Last observed:",page.Host.ObservedAt)
  @ReportTime("Last received:",page.Host.ReceivedAt)
  if page.Host.Ready!="" {
   <span>Node ready: { page.Host.Ready }</span>
  }
 </div>
 if page.Host.Status=="stale" {
  @HostNotice("stale","Telemetry is stale","Reports are more than three minutes old. Values below are the last observations.",alert.ToneWarning)
 }
 if page.Host.Status=="partial" {
  @HostNotice("partial","Some measurements are unavailable","Some measurements are unavailable. Collection may be starting or missing access to host metrics.",alert.ToneWarning)
 }
 if page.Host.Status=="unavailable" {
  @HostNotice("unavailable","No telemetry yet","No telemetry has arrived. Enable host collection on the agent to see measurements.",alert.ToneInfo)
 }
 <h2 class="balemoh-host-heading">Latest measurements</h2>
 <div class="balemoh-host-grid">
  @card.Card(card.Config{RootClass:"balemoh-host-card",Title:"CPU",Body:MetricValue(percentage(page.Host.CPU),"Share of total CPU capacity")})
  @card.Card(card.Config{RootClass:"balemoh-host-card",Title:"Memory",Body:MetricValue(percentage(page.Host.Memory),memorySize(page.Host.MemoryUsed)+" used / "+memorySize(page.Host.MemoryTotal)+" total")})
 </div>
}
templ HostNodes(page HostDetail) {
 if page.Host.Kind=="Kubernetes cluster" {
  <h2>Nodes</h2>
  if len(page.Children)>0 {
   @HostTable(page.Children,nil)
  } else {
   <p>No node inventory received.</p>
  }
 }
}
templ HostWorkloads(page HostDetail) {
 <p class="balemoh-muted">Reported pods or containers, their runtime state and restart counts.</p>
 if !page.Host.InventoryAvailable {
  <p>Workload inventory is unavailable or incomplete.</p>
 }
 if len(page.Workloads)>0 {
  <div class="balemoh-table-scroll" tabindex="0" role="region" aria-label="Workload inventory">
   @table.Table(table.Config{RootClass:"balemoh-host-workloads",ID:"host-workloads",Caption:"Last reported workloads",Columns:workloadColumns(page.Host.Kind),Rows:workloadRows(page.Workloads)})
  </div>
 } else if page.Host.InventoryAvailable {
  <p>No workloads reported.</p>
 }
}
func hostChartID(cpu bool)string{if cpu{return "host-cpu-chart"};return "host-memory-chart"}
templ HostChart(page HostDetail,cpu bool) {
 @chartcontrol.Wrapper(chartcontrol.WrapperConfig{Label:historyChart(page,cpu).Label,Export:&chartcontrol.ExportOptions{Disabled:true}},HostChartTarget(page,cpu))
}
templ HostChartTarget(page HostDetail,cpu bool) {
 <div id={ hostChartID(cpu) }>@HostChartContent(page,cpu)</div>
}
templ HostDetailIndicators(host Host) {
 <span class="balemoh-host-kind-icon" role="img" aria-label={ host.Kind } title={ host.Kind }>@HostGlyph(host)</span>
 <div id="host-detail-status">@HostDetailStatus(host)</div>
}
templ HostDetailStatus(host Host) {
 @tooltip.Tooltip("host-status-tooltip",hostStatus(host.Status),tooltip.WithPosition(tooltip.PositionBottom),tooltip.WithPortal(true),tooltip.WithTrigger(HostDetailStatusDot(host)))
}
templ HostDetailStatusDot(host Host) {
 @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("balemoh-widget-status-trigger"),button.WithAttrs(templ.Attributes{"id":"host-status-dot","aria-label":host.Name+": "+hostStatus(host.Status),"data-host-name":host.Name,"aria-describedby":"host-status-tooltip"})) {
  <span id="host-status-value">@HostDetailStatusValue(host)</span>
 }
}
templ HostDetailStatusValue(host Host) {
 <span aria-hidden="true" data-telemetry-status={ hostStatus(host.Status) }>@badge.Badge(badge.Config{Tone:hostStatusTone(host.Status),RootClass:"balemoh-widget-status-dot"})</span>
}
templ HostLiveBadge(message string) {
 @badge.Badge(badge.Config{Label:message,Tone:badge.ToneInfo,RootClass:"balemoh-live-badge"})
}
templ HostLiveStatus(message string) {
 <div id="host-live-status" hx-swap-oob="innerMorph">@HostLiveBadge(message)</div>
}
templ HostLiveSnapshot(page HostDetail) {
 @HostLiveStatus("Live updates connected")
 <span id="host-status-value" hx-swap-oob="innerMorph">@HostDetailStatusValue(page.Host)</span>
 <div id="host-measurements" hx-swap-oob="innerMorph">@HostMeasurements(page)</div>
 <div id="host-cpu-chart" hx-swap-oob="innerHTML">@HostChartContent(page,true)</div>
 <div id="host-memory-chart" hx-swap-oob="innerHTML">@HostChartContent(page,false)</div>
 if page.Host.Kind=="Kubernetes cluster" {
 <div id="host-nodes" hx-swap-oob="innerMorph">@HostNodes(page)</div>
 }
 <div id="host-workloads-panel" hx-swap-oob="innerMorph">@HostWorkloads(page)</div>
}
templ HostChartContent(page HostDetail,cpu bool) {
 if hasHistory(page,cpu) {
  <div class="balemoh-host-history">
   @line.Line(historyChart(page,cpu))
  </div>
 } else {
  @emptystate.EmptyState(emptystate.Config{Title:"No measurements yet",Description:"History appears as agents report. Missing measurements are never shown as zero."})
 }
}
