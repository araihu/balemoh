package view

import (
	"github.com/araihu/goshtoso/components/alert"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/card"
	"github.com/araihu/goshtoso/components/checkbox"
	"github.com/araihu/goshtoso/components/emptystate"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/tooltip"
	"net/url"
)

type Widget struct {
	ID      string
	SourceKind string
	Content templ.Component
}
type Dashboard struct {
	Widgets     []Widget
	Services    []Service
	Unavailable []string
}

templ WidgetGrid(widgets []Widget) {
	if len(widgets)==0 {
		@emptystate.EmptyState(emptystate.Config{Title: "No pinned widgets", Description: "Pin services from Staging or add host metrics from a host page.", Action: ReviewStagingAction(), RootClass: "balemoh-empty-state"})
	}
	for _,widget:=range widgets {
		<div id={ "widget-" + widget.ID } data-dashboard-widget>@widget.Content</div>
	}
}

templ DashboardGrid(page Dashboard) {
	if len(page.Widgets)==0 && len(page.Unavailable)==0 {
		@WidgetGrid(nil)
	}
	for _, section := range dashboardSections(page.Widgets) {
		<section id={ "dashboard-section-" + section.ID } aria-labelledby={ "dashboard-heading-" + section.ID } class="balemoh-dashboard-section">
			<h2 id={ "dashboard-heading-" + section.ID }>{ section.Title }</h2>
			<div class="balemoh-service-grid" data-dashboard-layout>@WidgetGrid(section.Widgets)</div>
		</section>
	}
}

templ DashboardWarnings(sources []string) {
	if len(sources)>0 {
		@alert.Alert(alert.Config{Title: "Some widgets are unavailable", Description: "A source could not be refreshed. Last received values may be shown. Refresh to retry.", Tone: alert.ToneWarning})
	}
}

templ UnavailableWidget(title string) {
	@card.Card(card.Config{Title: title, Description: "This widget is unavailable in this version."})
}

templ HostWidget(host Host, message string) {
	@card.Card(card.Config{RootClass: "balemoh-service-card", Body: HostWidgetBody(host, message), Footer: HostWidgetActions(host)})
}

templ HostWidgetBody(host Host, message string) {
	<div class="balemoh-widget-heading">
		@HostGlyph(host)
		<h3 class="balemoh-widget-title">{ host.Name }</h3>
		if message == "" {
			@tooltip.Tooltip("widget-status-tooltip-"+host.ID, hostStatus(host.Status), tooltip.WithPosition(tooltip.PositionTop), tooltip.WithPortal(true), tooltip.WithTrigger(HostWidgetStatusDot(host)))
		}
	</div>
	@HostWidgetMetrics(host, message)
}

templ HostWidgetStatusDot(host Host) {
	@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithRootClass("balemoh-widget-status-trigger"), button.WithAttrs(templ.Attributes{"id": "widget-status-" + host.ID, "aria-label": host.Name + ": " + hostStatus(host.Status), "aria-describedby": "widget-status-tooltip-" + host.ID})) {
		<span aria-hidden="true">@badge.Badge(badge.Config{Tone: hostStatusTone(host.Status), RootClass: "balemoh-widget-status-dot"})</span>
	}
}

templ HostWidgetMetrics(host Host, message string) {
	if message!="" {
		<p role="status">{ message }</p>
	} else {
		<dl class="balemoh-widget-metrics">
			<div><dt>CPU</dt><dd>{ percentage(host.CPU) }</dd></div>
			<div><dt>Memory</dt><dd>{ percentage(host.Memory) }</dd></div>
		</dl>
		<small class="balemoh-muted">@ReportTime("Observed: ", host.ObservedAt)</small>
	}
}

templ HostWidgetActions(host Host) {
	<div class="balemoh-host-actions">
		@link.Link("/hosts/" + url.PathEscape(host.ID)) {
			<span>View host</span>
		}
		<div id={ "widget-refresh-host-" + host.ID } hx-morph-skip>
			<form
				method="get"
				action="/"
				data-widget-refresh
				hx-get={ "/dashboard/widgets/host/" + url.PathEscape(host.ID) }
				hx-target={ "#widget-host-" + host.ID }
				hx-swap="innerMorph"
				hx-disable="find button"
				hx-sync="this:drop"
				x-data="{}"
				x-on:htmx:error="$refs.feedback.textContent = 'Refresh failed. Try again.'"
				x-on:htmx:finally:request="$nextTick(() => $el.querySelector('button')?.focus())"
			>
				@tooltip.Tooltip("widget-refresh-tooltip-"+host.ID, "Refresh", tooltip.WithPosition(tooltip.PositionTop), tooltip.WithTrigger(HostWidgetRefreshButton(host)))
				<small id={ "widget-refresh-feedback-host-" + host.ID } role="status" x-ref="feedback" class="balemoh-widget-feedback"></small>
			</form>
		</div>
	</div>
}

templ HostWidgetRefreshButton(host Host) {
	@button.Button(button.WithType("submit"), button.WithSize(button.SizeSmall), button.WithAppearance(button.AppearancePlain), button.WithRootClass("balemoh-icon-button"), button.WithAttrs(templ.Attributes{"id": "widget-refresh-action-host-" + host.ID, "aria-label": "Refresh " + host.Name})) {
		@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidArrowPath, Decorative: true})
	}
}

templ WidgetRefreshFeedback(message string) {
	{ message }
}

templ WidgetRefreshed(widget Widget) {
	@widget.Content
	<span id={ "widget-refresh-feedback-" + widget.ID } hx-swap-oob="innerHTML"><span class="sr-only">Updated</span></span>
}

templ HostSelection(id string, selected, unavailable bool, window, message string, focus bool) {
	<div id={ "host-selection-" + id } hx-morph-skip>
		<form
			method="post"
			action={ "/hosts/" + url.PathEscape(id) + "/selection" }
			hx-post={ "/hosts/" + url.PathEscape(id) + "/selection" }
			hx-target={ "#host-selection-" + id }
			hx-swap="outerHTML"
			hx-disable="find input[type='checkbox']"
			hx-sync="this:drop"
			x-data="{}"
			x-on:htmx:error="$refs.choice.checked = $refs.choice.defaultChecked; $refs.failure.textContent = 'Connection failed. Try again.'"
		>
			<input type="hidden" name="selection_form" value="host"/>
			<input type="hidden" name="range" value={ window }/>
			@checkbox.Checkbox(checkbox.Config{
				ID: "host-selection-action-" + id, Name: "enabled", Value: "true", Label: "Show on home", Checked: selected, Disabled: unavailable,
				InputAttrs: templ.Attributes{"x-ref": "choice", "onchange": "this.form.requestSubmit()", "aria-describedby": "host-selection-feedback-" + id, "style": "border-color: var(--balemoh-muted)"},
			})
			if focus {
				<span hidden x-data="{}" x-init="$nextTick(() => $el.parentElement.querySelector('input[type=checkbox]')?.focus())"></span>
			}
			<span id={ "host-selection-feedback-" + id } role="alert" x-ref="failure">{ message }</span>
			<noscript>
				@button.Button(button.WithType("submit"), button.WithSize(button.SizeSmall)) {
					<span>Save</span>
				}
			</noscript>
		</form>
	</div>
}

templ DashboardLiveSnapshot(page Dashboard, message string) {
	<div id="dashboard-grid" hx-swap-oob="innerMorph">@DashboardGrid(page)</div>
	<div id="dashboard-warnings" hx-swap-oob="innerMorph">@DashboardWarnings(page.Unavailable)</div>
	<div id="dashboard-live-status" hx-swap-oob="innerMorph">@HostLiveBadge(message)</div>
}

templ DashboardLiveStatus(message string) {
	<div id="dashboard-live-status" hx-swap-oob="innerMorph">@HostLiveBadge(message)</div>
}

templ DashboardLiveUnavailable(sources []string) {
	<div id="dashboard-warnings" hx-swap-oob="innerMorph">@DashboardWarnings(sources)</div>
	@DashboardLiveStatus("Some sources unavailable; showing last received values.")
}
