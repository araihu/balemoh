package view

import (
	"fmt"
 "strings"
 "strconv"
 "github.com/araihu/goshtoso/components/textinput"
 "github.com/araihu/goshtoso-charts/components/dependencies"
 "github.com/araihu/goshtoso/components/modal"
	"github.com/araihu/balemoh/ui/internal/appicons"
	"github.com/araihu/goshtoso/components/alert"
 "github.com/araihu/goshtoso/components/avatar"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/card"
	"github.com/araihu/goshtoso/components/checkbox"
	"github.com/araihu/goshtoso/components/drawer"
	"github.com/araihu/goshtoso/components/dropdown"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/pageheader"
	"github.com/araihu/goshtoso/components/table"
 "github.com/araihu/goshtoso/components/tabs"
	"github.com/araihu/goshtoso/components/toast"
	"github.com/araihu/goshtoso/components/tooltip"
)

templ PageContent(data PageData) {
 if data.PluginWarning {
  @alert.Alert(alert.Config{Title: "Plugin unavailable", Description: "An installed plugin is incompatible or could not start. Core pages remain available."})
 }
 if data.HostDetail != nil && data.Error == "" {
  @dependencies.Dependencies()
 }
	if data.Appearance.Warning!="" {
 @alert.Alert(alert.Config{Title:"Temporary appearance",Description:data.Appearance.Warning,Tone:alert.ToneWarning})
 }
 <p id="appearance-font-warning" role="status" hidden></p>
 @toast.ToastContainer(toast.ContainerConfig{DisplayDuration: 4000})
	if data.Notice != "" {
		<div hidden x-data="{}" x-init={ successToastEvent(data.Notice) }></div>
	}
	<section class="balemoh-content" aria-label={ data.Title }
 if data.HostDetail != nil {
  id="host-detail"
 }
 >
		if data.Editor != nil {
 @pageheader.PageHeader(pageheader.Config{Title: data.Title, HideSeparator: true})
 @link.Link(stagingURL(data.Editor.State()), link.WithIcon(icon.Icon(icon.Config{SpriteURL:heroicons.SpriteURL,Symbol:heroicons.Icon16SolidArrowUturnLeft,Decorative:true})), link.WithIconPosition(link.IconLeading)) { Back to Staging }
 } else if data.Staging {
			@pageheader.PageHeader(pageheader.Config{
				Title:       data.Title,
				HideSeparator: true,
				TitleSuffix: tooltip.Help("staging-help", "About Staging", data.Description),
				TitleAttrs:  templ.Attributes{"id": "balemoh-page-heading"},
				Actions:     StagingActions(),
			})
		}
		if data.Error != "" {
			<div tabindex="-1" x-data="{}" x-init="$el.focus()">
 @alert.Alert(alert.Config{Title: "Request could not be completed", Description: data.Error, Tone: alert.ToneDanger, RootClass: "balemoh-alert"})
 </div>
		}
		if data.NotificationsPage != nil {
 @NotificationsContent(*data.NotificationsPage)
 } else if data.PluginContent != nil {
 @data.PluginContent
 } else if data.HostDetail != nil {
 if data.Error == "" {
 @HostContent(*data.HostDetail)
 }
 } else if data.HostsPage != nil {
 @HostsContent(*data.HostsPage, data.Error == "")
 } else if data.ThemeEditor != nil {
 @ThemeEditorContent(*data.ThemeEditor)
 } else if data.IconPage != nil {
 @PresentationContent(*data.IconPage, data.Themes)
 } else if data.Editor != nil {
 if data.Editor.Creating {
 @ServiceEditor(*data.Editor)
 } else {
 @tabs.Tabs(tabs.Config{ID:"service-editor", DefaultTab:"details", SyncHash:data.Editor.EditError == "", Tabs:serviceEditorTabs(*data.Editor)})
 }
		} else if data.Staging {
			@StagingContent(data)
		} else {
			if data.Path != "" && data.Error != "" {
 @link.Link(data.Path) { Back to host }
 } else {
 @HomepageContent(data)
 }
		}
	</section>

 if data.IconPage != nil && data.IconPage.Editing == nil && data.IconPage.Details == nil {
  @drawer.Drawer(drawer.Config{ID:"iconUpload",Title:"Upload icon",BodyID:"icon-upload-body"}) {
   @IconUploadDrawerBody(LibraryIcon{}, "")
  }
  @drawer.Drawer(drawer.Config{ID:"iconDetails",Title:"Icon details",BodyID:"icon-details-body"})
 }
}

templ StagingActions() {
 @link.Link("/staging/services/new", link.WithAppearance(link.AppearanceButton), link.WithSize(link.SizeSmall)) { Add service }
	<form method="post" action="/staging/sync">
		@tooltip.Tooltip("sync-discovery-tooltip", "Sync discovery", tooltip.WithPosition(tooltip.PositionBottom), tooltip.WithTrigger(SyncButton()))
	</form>
}

templ SyncButton() {
	@button.Button(button.WithType("submit"), button.WithTone(button.ToneAlternate), button.WithSize(button.SizeSmall), button.WithRootClass("balemoh-icon-button"), button.WithAttrs(templ.Attributes{"aria-label": "Sync discovery"})) {
		@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidArrowPath, Decorative: true})
	}
}

templ HomepageContent(data PageData) {
 if data.Dashboard != nil {
  <div { homepageAttrs(data.Services)... }>
   <div id="dashboard-live" data-dashboard-live hx-sse:connect="/dashboard/events" hx-target="#dashboard-live-status" hx-swap="innerMorph">
    <div id="dashboard-live-status" class="sr-only" role="status" tabindex="-1" hx-morph-skip>@HostLiveBadge("Connecting to live updates…")</div>
   </div>
   <div id="dashboard-warnings">@DashboardWarnings(data.Dashboard.Unavailable)</div>
   <div id="dashboard-grid">@DashboardGrid(*data.Dashboard)</div>
   if len(data.Services)>0 {
 @modal.Dialog(modal.DialogConfig{ID:"home-search-modal",Title:"Search services",Compact:true,Content:HomeSearchResults(data.Services)})
 }
  </div>
 }
}

templ ServiceCard(service Service, serviceIcon templ.Component) {
	@card.Card(card.Config{
		Title:       service.DisplayName,
		Description: service.Description,
		TitlePrefix: serviceIcon,
		Body:        ServiceCardAddresses(service),
		RootClass:   "balemoh-service-card",
	})
}

templ ServiceCardIcon(service Service) {
 @avatar.Avatar(avatar.Config{Size: avatar.SizeXS, Shape: avatar.ShapeSquare, Icon: ServiceGlyph(service), RootClass: "balemoh-service-avatar"})
}

templ ServiceGlyph(service Service) {
 if service.Icon.ID != "" {
 <span class="balemoh-service-card-icon">@LibraryImage(service.Icon)</span>
 } else if isKubernetes(service) {
		<span class="balemoh-service-card-icon">
			@appicons.Icon(appicons.Config{Symbol: appicons.IconKubernetesKubernetes, Label: "Kubernetes"})
		</span>
	}
}

templ ServiceCardAddresses(service Service) {
	<div class="balemoh-card-addresses">
		if addresses := groupAddresses(service); len(addresses) > 0 {
			@link.Link(addresses[0], link.WithTarget("_blank")) {
				{ addressLabel(addresses[0]) }
			}
			if len(addresses) > 1 {
				@dropdown.Dropdown(dropdown.Config{
					ID:        "service-addresses-" + service.ID,
					RootClass: "balemoh-address-menu",
					Trigger:   AddressCountTrigger(service, len(addresses)-1),
					MenuAlign: dropdown.AlignEnd,
					Sections:  []dropdown.Section{{Items: addressMenuItems(addresses[1:])}},
				})
			}
		} else {
			<span class="balemoh-muted">No public address</span>
		}
	</div>
}

templ AddressCountTrigger(service Service, count int) {
	@button.Button(button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"aria-label": "More addresses for " + service.DisplayName})) {
		{ fmt.Sprintf("+%d", count) }
	}
}

templ StagingContent(data PageData) {
 @tabs.Tabs(tabs.Config{ID:"staging-status",DefaultTab:data.Status,SyncHash:true,Tabs:stagingTabs(data)})
}

func stagingTabs(data PageData) []tabs.Tab {
 result := []tabs.Tab{}
 for _, state := range []string{"live","missing","hidden"} {
  filtered := data
  filtered.Status=state
  filtered.Services=nil
  for _, service := range data.Services {if service.State()==state {filtered.Services=append(filtered.Services,service)}}
  label:=strings.ToUpper(state[:1])+state[1:]
  result=append(result,tabs.Tab{ID:state,Label:label,Badge:strconv.Itoa(len(filtered.Services)),Content:ServiceTable(filtered)})
 }
 return result
}

templ SyncAction() {
	<form method="post" action="/staging/sync">
		@button.Button(button.WithType("submit"), button.WithTone(button.TonePrimary)) {
			Sync discovery
		}
	</form>
}

templ ReviewStagingAction() {
	@link.Link("/staging", link.WithAppearance(link.AppearanceButton)) {
		Review staging
	}
}

templ ServiceTable(data PageData) {
	if len(data.Services) > 0 {
		<div class="balemoh-table-scroll">
			@table.Table(table.Config{
				ID:        "balemoh-services-" + data.Status,
				Caption:   "Balemoh services",
				Columns:   serviceTableColumns(data.Staging && data.Status != "missing" && data.Status != "hidden"),
				Rows:      serviceTableRows(data),
				RootClass: "balemoh-service-table",
			})
		</div>
	} else if data.Error == "" {
		<div class="balemoh-table-placeholder">No services in this view.</div>
	}
}

templ ServiceIdentity(service Service) {
	<div class="balemoh-service-identity">
		<div class="balemoh-service-name">
			@ServiceCardIcon(service)
			<strong>{ service.DisplayName }</strong>
		</div>
		<small class="balemoh-muted">
 if service.IsManual() {
 <span>Manual</span>
 } else {
 { service.Namespace }
 }
 </small>
		if service.Description != "" && !isKubernetes(service) {
			<span>{ service.Description }</span>
		}
	</div>
}

templ ServiceSelection(service Service) {
	<form
		method="post"
		action={ templ.SafeURL(serviceActionURL(service.ID, "selection")) }
		class="balemoh-pin-form"
		hx-post={ serviceActionURL(service.ID, "selection") }
		hx-target="closest tr"
		hx-swap="outerHTML"
		hx-disable="find input"
		hx-sync="this:drop"
		hx-on::finally:request="if (event.detail.ctx.status.startsWith('error:') || event.detail.ctx.hx?.reswap === 'none') { queueMicrotask(() => { const input = this.querySelector('input'); input.checked = input.defaultChecked; input.disabled = true; this.querySelector('[data-pin-error]').hidden = false; }); }"
	>
		@checkbox.Checkbox(checkbox.Config{
			ID:         "select-" + service.ID,
			Name:       "pinned",
			Value:      "true",
			Checked:    service.Pinned,
			InputAttrs: templ.Attributes{"autofocus": service.PinAutofocus, "aria-label": selectionLabel(service), "onchange": "this.form.requestSubmit()", "style": "border-color: var(--balemoh-muted)"},
		})
		if service.PinError != "" {
			<small role="alert">{ service.PinError }</small>
		}
		<small hidden data-pin-error role="alert">
			Save unconfirmed.
			@link.Link("/staging") {
				Refresh
			}
		</small>
		<noscript>
			@button.Button(button.WithType("submit"), button.WithSize(button.SizeSmall)) {
				Save
			}
		</noscript>
	</form>
}

templ GroupAddresses(service Service) {
	<div class="balemoh-endpoint-list">
		if addresses := groupAddresses(service); len(addresses) > 0 {
			for _, address := range addresses {
				@link.Link(address, link.WithTarget("_blank")) {
					{ addressLabel(address) }
				}
			}
		} else {
			<span class="balemoh-muted">No public address</span>
		}
	</div>
}

templ StagingRow(service Service) {
	@table.TableRow(table.Config{ID: "balemoh-services", Columns: serviceTableColumns(true)}, serviceTableRows(PageData{Staging: true, Services: []Service{service}})[0])
}

const homeSearchState = `{query: '', move(step) {
 const links = [...document.querySelectorAll('#home-search-results a')].filter(el => el.getClientRects().length);
 if (!links.length) return;
 const current = links.indexOf(document.activeElement);
 const index = current < 0 ? (step > 0 ? 0 : links.length - 1) : (current + step + links.length) % links.length;
 links[index].focus(); links[index].scrollIntoView({block: 'nearest'});
}}`
const homepageSearchKeys = `
 const e = $event;
 if (e.defaultPrevented || e.isComposing || e.altKey) return;
 const own = document.querySelector('#home-search-modal');
 if ([...document.querySelectorAll('[role="dialog"], dialog[open], [role="menu"]')].some(el => el !== own && el.getClientRects().length)) return;
 if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
  e.preventDefault();
  if (own.open) { document.querySelector('#home-search').focus(); document.querySelector('#home-search').select(); }
  else { query = ''; $dispatch('modal:open', {id:'home-search-modal'}); }
  return;
 }
 if (e.metaKey || e.ctrlKey || e.key.length !== 1 || e.key.trim() === '') return;
 if (e.target.closest('input, textarea, select, [role="textbox"], [contenteditable]:not([contenteditable="false"])')) return;
 e.preventDefault(); query = own.open ? query + e.key : e.key;
 if (own.open) document.querySelector('#home-search').focus();
 else $dispatch('modal:open', {id:'home-search-modal'});
`

templ HomeSearchResults(services []Service) {
 <div x-on:keydown.arrow-down.prevent="move(1)" x-on:keydown.arrow-up.prevent="move(-1)">
  @textinput.TextInput(textinput.Config{ID:"home-search",Type:textinput.TypeSearch,Placeholder:"Search services…",Autocomplete:"off",RootClass:"balemoh-search-input",InputAttrs:templ.Attributes{"aria-label":"Search services","autofocus":true,"x-model":"query","x-on:keydown.escape.prevent.stop":"$dispatch('modal:close', {id:'home-search-modal'})","x-on:keydown.enter.prevent":"[...document.querySelectorAll('#home-search-results a')].find(el => el.getClientRects().length)?.click()"}})
  <ul id="home-search-results" class="balemoh-search-results" aria-label="Matching services" x-show={"!(" + homeSearchEmpty(services) + ")"}>
   for _, service := range services {
    <li x-show={homeSearchMatch(service)}>
     if addresses := groupAddresses(service); len(addresses)>0 {
      @link.Link(addresses[0],link.WithTarget("_blank"),link.WithAttrs(templ.Attributes{"x-on:keydown.space.prevent.stop":"$el.click()"})) {
       @ServiceCardIcon(service)
       <span class="balemoh-search-name">{service.DisplayName}</span>
       <span class="balemoh-search-description">{service.Description}</span>
       <span class="balemoh-search-type">Service</span>
      }
     } else {
      <span>{service.DisplayName} <span class="balemoh-muted">No public address</span></span>
     }
    </li>
   }
  </ul>
  <p class="balemoh-search-empty" role="status" x-cloak x-show={homeSearchEmpty(services)}>No matching services.</p>
 </div>
}

func homeSearchMatch(service Service) string {
 text := strings.ToLower(service.DisplayName + " " + service.Description + " " + strings.Join(groupAddresses(service), " "))
 return strconv.Quote(text) + ".includes(query.trim().toLowerCase())"
}
func homeSearchEmpty(services []Service) string {
 matches := make([]string, 0, len(services))
 for _, service := range services { matches = append(matches, homeSearchMatch(service)) }
 if len(matches)==0 { return "true" }; return "!(" + strings.Join(matches, " || ") + ")"
}

func homepageAttrs(services []Service)templ.Attributes{
 if len(services)==0{return templ.Attributes{}}
 return templ.Attributes{"x-data":homeSearchState,"x-on:keydown.window":homepageSearchKeys}
}

// Keep panels mounted so switching views retains unsaved form and icon state.
func serviceEditorTabs(service Service) []tabs.Tab {
 result := []tabs.Tab{
  {ID:"details", Label:"Details", Content:ServiceEditor(service)},
  {ID:"visibility", Label:"Visibility", Content:ServiceLifecycle(service)},
 }
 if !service.IsManual() {
  result=append(result,tabs.Tab{ID:"resources", Label:"Resources", Content:ServiceResources(service)})
 }
 return result
}
